        "in": "path",
        "required": true,
        "description": "Designation ID",
        "schema": {
          "type": "integer",
          "example": 1
        }
      }
    },
    "schemas": {
      "CustomerInput": {
        "type": "object",
        "required": [
          "customer_name",
          "phone",
          "email"
        ],
        "properties": {
          "customer_name": {
            "type": "string",
            "example": "Rahul Sharma"
          },
          "company_name": {
            "type": "string",
            "example": "Rahul Technologies"
          },
          "phone": {
            "type": "string",
            "example": "9876543210"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "rahul@example.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ],
            "example": "Active"
          }
        }
      },
      "AddressInput": {
        "type": "object",
        "required": [
          "customer_id",
          "address_type",
          "address",
          "city",
          "state",
          "pincode"
        ],
        "properties": {
          "customer_id": {
            "type": "integer",
            "example": 1
          },
          "address_type": {
            "type": "string",
            "example": "Office"
          },
          "address": {
            "type": "string",
            "example": "42, Sector 15"
          },
          "gst_number": {
            "type": "string",
            "example": "24ABCDE1234F1Z5"
          },
          "city": {
            "type": "string",
            "example": "Vadodara"
          },
          "state": {
            "type": "string",
            "example": "Gujarat"
          },
          "pincode": {
            "type": "string",
            "example": "390015"
          },
          "country": {
            "type": "string",
            "example": "India"
          }
        }
      },
      "ServiceInput": {
        "type": "object",
        "required": [
          "customer_id",
          "service_type"
        ],
        "properties": {
          "customer_id": {
            "type": "integer",
            "example": 1
          },
          "service_type": {
            "type": "string",
            "example": "Website Development"
          },
          "domain": {
            "type": "string",
            "example": "example.com"
          },
          "renewal_date": {
            "type": "string",
            "format": "date",
            "example": "2027-08-27"
          },
          "duration": {
            "type": "integer",
            "example": 12
          },
          "expiry_date": {
            "type": "string",
            "format": "date",
            "example": "2028-08-27"
          },
          "renewal_amount": {
            "type": "number",
            "format": "double",
            "example": 15000
          },
          "service_status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive",
              "Expired"
            ],
            "example": "Active"
          }
        }
      },
      "JoiningCandidateInput": {
        "type": "object",
        "required": [
          "ename",
          "fname",
          "mobile",
          "gender",
          "mstatus"
        ],
        "properties": {
          "ename": {
            "type": "string",
            "description": "Employee/candidate name (required)",
            "example": "Rahul Sharma"
          },
          "fname": {
            "type": "string",
            "description": "Father name (required)",
            "example": "Ramesh Sharma"
          },
          "dob": {
            "type": "string",
            "format": "date",
            "description": "Date of birth, optional. Format YYYY-MM-DD",
            "example": "1995-06-15"
          },
          "gender": {
            "type": "string",
            "description": "Gender (required)",
            "example": "Male"
          },
          "address": {
            "type": "string",
            "description": "Address, optional",
            "example": "42, Sector 15, Vadodara"
          },
          "mobile": {
            "type": "string",
            "description": "Mobile number (required). Pattern: starts with + or digit, then 7-14 digits/spaces/hyphens",
            "example": "9876543210"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email, optional. Valid email when provided",
            "example": "rahul@example.com"
          },
          "aadhar": {
            "type": "string",
            "description": "Aadhaar number, optional. Exactly 12 digits when provided",
            "example": "123456789012"
          },
          "mstatus": {
            "type": "string",
            "description": "Marital status (required)",
            "example": "Single"
          },
          "qual": {
            "type": "string",
            "description": "Qualification, optional",
            "example": "B.Tech"
          },
          "hstudy": {
            "type": "string",
            "description": "Higher study, optional",
            "example": "M.Tech"
          },
          "linkedin": {
            "type": "string",
            "description": "LinkedIn profile URL, optional",
            "example": "https://linkedin.com/in/rahulsharma"
          },
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "Candidate photo file, optional"
          },
          "resume": {
            "type": "string",
            "format": "binary",
            "description": "Resume file, optional"
          },
          "degree": {
            "type": "string",
            "format": "binary",
